# Copy to .env on the server and fill in. Never commit .env: it holds secrets.

# The site's address; used for links in emails and to check where requests come from.
PUBLIC_URL=https://uttt.org

# Cloudflare passes the visitor's real address in this header; only the tunnel can reach the app.
CLIENT_IP_HEADER=cf-connecting-ip

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# Bot check on sign-up (Cloudflare → Turnstile → your widget).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Backups: a Cloudflare R2 bucket and an API token with read/write access to it.
BACKUP_BUCKET=uttt-backups
BACKUP_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=

# Email (optional until a provider is chosen; without it, emails are only logged).
# SMTP_URL=smtps://user:password@smtp-relay.brevo.com:465
# MAIL_FROM=UTTT <noreply@uttt.org>
